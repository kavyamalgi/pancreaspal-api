# AWS / Bedrock Knowledge Base
# Copy to .env and fill in values. Do not commit .env.

AWS_REGION=us-east-1

# From the Bedrock console after you create the Knowledge Base
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_DATA_SOURCE_ID=

# S3 prefix that is the Knowledge Base data source, e.g. s3://pancreaspal-gold-standard/gold-standard/
BEDROCK_S3_URI=

# Claude model or inference profile ID from the Bedrock console, e.g.
# anthropic.claude-sonnet-4-5-20250929-v1:0
# or us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=

# DynamoDB table for chat conversation memory (create with: python create_conversation_table.py)
DYNAMODB_CONVERSATION_TABLE=pancreaspal-conversations

# Optional on a laptop: leave unset to store extracted patient text in patient_files/.
# Required on App Runner. Distinct from the Gold Standard bucket.
PATIENT_FILES_S3_BUCKET=
# PATIENT_FILES_S3_PREFIX=patients/

# Comma-separated extra CORS origins (Amplify URL after deploy). localhost:3000 is always allowed.
# CORS_ORIGINS=https://main.dxxxxx.amplifyapp.com

# Optional: boto3 uses the default credential chain (env keys, AWS_PROFILE, or ~/.aws/credentials).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
